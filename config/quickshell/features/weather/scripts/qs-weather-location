#!/usr/bin/env bash
# Weather location store for the bar weather panel.
#
# Same CLI shape as omarchy-weather-location, but the state file belongs to this
# shell: $XDG_STATE_HOME/quickshell/weather.json
#
#   qs-weather-location                       print the stored location
#   qs-weather-location --set NAME            store a name (IP auto-detect for coords)
#   qs-weather-location --set NAME LAT,LON    store a name with coordinates
#   qs-weather-location --clear               forget the location
set -euo pipefail
export LC_ALL=C

die() { printf 'qs-weather-location: %s\n' "$*" >&2; exit 1; }

need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }
need jq

state_dir() {
    printf '%s/quickshell\n' "${XDG_STATE_HOME:-$HOME/.local/state}"
}

state_file() {
    printf '%s/weather.json\n' "$(state_dir)"
}

read_state() {
    local file
    file="$(state_file)"
    [[ -r "$file" ]] || printf '{}\n'
    cat "$file" 2>/dev/null || printf '{}\n'
}

write_state() {
    local file
    file="$(state_file)"
    mkdir -p "$(dirname "$file")"
    # Write-then-rename: the panel watches this file and reloads on any change,
    # and a half-written file would read as "no location".
    local tmp
    tmp="$(mktemp "${file}.XXXXXX")"
    printf '%s\n' "$1" >"$tmp"
    mv "$tmp" "$file"
}

print_location() {
    read_state | jq -c '{name: (.name // ""), latitude: (.latitude // null), longitude: (.longitude // null)}'
}

set_location() {
    local name="$1" coords="${2:-}"

    name="$(printf '%s' "$name" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

    if [[ -z "$name" ]]; then
        write_state '{"name": "", "latitude": null, "longitude": null}'
        return 0
    fi

    if [[ -z "$coords" ]]; then
        local encoded
        encoded="$(printf '%s' "$name" | jq -Rs .)"
        write_state "{\"name\": ${encoded}, \"latitude\": null, \"longitude\": null}"
        return 0
    fi

    if ! [[ "$coords" =~ ^-?[0-9]+([.][0-9]+)?,-?[0-9]+([.][0-9]+)?$ ]]; then
        die "coordinates must be LAT,LON, got: $coords"
    fi

    local encoded lat lon
    encoded="$(printf '%s' "$name" | jq -Rs .)"
    lat="${coords%%,*}"
    lon="${coords##*,}"
    write_state "{\"name\": ${encoded}, \"latitude\": ${lat}, \"longitude\": ${lon}}"
}

clear_location() {
    write_state '{"name": "", "latitude": null, "longitude": null}'
}

main() {
    case "${1:-}" in
        "" | "--get" | "get")
            print_location
            ;;
        --set)
            [[ -n "${2:-}" ]] || die "--set needs a name"
            set_location "$2" "${3:-}"
            ;;
        --clear)
            clear_location
            ;;
        *)
            printf 'usage: qs-weather-location [--get|--set NAME [LAT,LON]|--clear]\n' >&2
            exit 2
            ;;
    esac
}

main "$@"
