{
	"show_signature_help_after_edits": false,
	"edit_predictions": {
		"provider": "copilot",
	},
	"tabs": {
		"file_icons": true,
		"git_status": true,
	},
	"tab_bar": {
		"show_pinned_tabs_in_separate_row": false,
		"show": false,
	},
	"status_bar": {
		"cursor_position_button": true,
	},
	"ui_font_weight": 400.0,
	"ui_font_family": "IBM Plex Sans",
	"title_bar": {
		"button_layout": "platform_default",
		"show_user_picture": true,
		"show_sign_in": true,
		"show_onboarding_banner": false,
		"show_project_items": true,
		"show_branch_name": true,
		"show_branch_status_icon": true,
		"show_menus": false,
		"show_user_menu": true,
	},
	"global_lsp_settings": {
		"button": false,
	},
	"vim": {
		"gdefault": false,
		"use_smartcase_find": true,
		"toggle_relative_line_numbers": true,
	},
	"minimap": {
		"thumb": "hover",
		"show": "never",
	},
	"scrollbar": {
		"show": "never",
		"cursors": true,
	},
	"autoscroll_on_clicks": false,
	"which_key": {
		"enabled": true,
	},
	"relative_line_numbers": "enabled",
	"inline_code_actions": true,
	"gutter": {
		"line_numbers": true,
		"runnables": true,
		"breakpoints": true,
		"folds": true,
		"min_line_number_digits": 0,
		"bookmarks": true,
	},
	"buffer_font_family": "GeistMono Nerd Font",
	"buffer_font_fallbacks": ["IoskeleyMono Nerd Font Mono"],
	"diff_view_style": "split",
	"agent_servers": {
		"pi-acp": {
			"type": "registry",
		},
	},
	"language_models": {},
	"terminal": {
		"font_family": "GeistMono Nerd Font Mono",
		"font_size": 16.0,
	},

	"project_panel": {
		"button": true,
		"hide_gitignore": true,
		"dock": "left",
	},
	"buffer_line_height": "comfortable",
	"outline_panel": {
		"dock": "left",
	},
	"collaboration_panel": {
		"button": false,
		"dock": "left",
	},
	"allow_rewrap": "anywhere",
	"format_on_save": "on",
	"auto_update": false,
	"agent": {
		"play_sound_when_agent_done": "always",
		"notify_when_agent_waiting": "never",
		"default_model": {
			"provider": "openai-subscribed",
			"model": "gpt-5.6-sol",
			"enable_thinking": false,
			"effort": "xhigh",
		},
		"sidebar_side": "right",
		"dock": "right",
		"favorite_models": [],
		"model_parameters": [],
	},
	"git_panel": {
		"dock": "left",
	},
	"session": {
		"trust_all_worktrees": true,
	},
	"theme": {
		"mode": "dark",
		"light": "One Light",
		"dark": "Panda",
	},
	"telemetry": {
		"diagnostics": false,
		"metrics": false,
	},
	"toolbar": {
		"code_actions": false,
		"agent_review": true,
		"selections_menu": true,
		"breadcrumbs": false,
		"quick_actions": false,
	},
	"hard_tabs": true,
	"vim_mode": true,
	"icon_theme": {
		"mode": "dark",
		"light": "Material Icon Theme",
		"dark": "Material Icon Theme",
	},
	"ui_font_size": 15.0,
	"agent_buffer_font_size": 14.0,
	"agent_ui_font_size": 15.0,
	"buffer_font_size": 15.0,
	"buffer_font_weight": 300.0,
	"autosave": {
		"after_delay": {
			"milliseconds": 1000,
		},
	},
}
