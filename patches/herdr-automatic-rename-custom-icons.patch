diff --git i/automatic-rename.sh w/automatic-rename.sh
index 0263a94..ca0351d 100755
--- i/automatic-rename.sh
+++ w/automatic-rename.sh
@@ -147,6 +147,7 @@ def debrand($b): ($b | length) as $n
        and (.[$n:] | test("^([^[:alnum:]]|$)")) then .[$n:] else . end;
 def task($b): clean | lead
   | (if ($b | length) > 0 then debrand($b) | lead else . end)
+  | sub(" - [^ -]+$"; "")
   | sub("[[:space:]]+$"; "") | gsub("[[:space:]]+"; " ");
 def taskof($brands; $agent): task($brands[$agent | lc] // "");'
 
@@ -1013,7 +1014,13 @@ ar_pane_program() {
     | if ($p == null) then
         "", ""
       else
-        (($p.argv0 // (($p.argv // [])[0]) // $p.name // "") | clean | sub("^-"; "") | split("/") | last),
+        (
+          def unwrap_sudo:
+            if .[0] == "sudo" or .[0] == "doas" or .[0] == "run0" or .[0] == "pkexec" then
+              .[1:] | while(.[0] != null and (.[0] | startswith("-")); .[1:])
+            else . end;
+          (($p.argv // []) | unwrap_sudo | .[0] // $p.argv0 // $p.name // "") | clean | sub("^-"; "") | split("/") | last
+        ),
         (($p.cmdline // (($p.argv // []) | join(" "))) | clean)
       end
   ' 2>/dev/null
