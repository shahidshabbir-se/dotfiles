#!/usr/bin/env bash

# omarchy:summary=Measure live internet speed for one direction
# omarchy:group=network
# omarchy:args=[down|up]

# The Arch package installs the client under /usr/lib/omarchy. On NixOS there is
# no such tree, so prefer a client on PATH and keep the old location as a last
# resort for a checkout that ships one.
if [[ -n ${OMARCHY_SPEEDTEST_BINARY:-} ]]; then
  client=$OMARCHY_SPEEDTEST_BINARY
elif client=$(command -v omarchy-speedtest 2>/dev/null); then
  :
elif [[ -x /usr/lib/omarchy/speedtest ]]; then
  client=/usr/lib/omarchy/speedtest
else
  client=""
fi

if (( $# != 1 )) || [[ $1 != "down" && $1 != "up" ]]; then
  echo "Usage: omarchy-network-speedtest [down|up]" >&2
  exit 2
elif [[ -z $client || ! -x $client ]]; then
  echo "The speed test client is missing: add the omarchy-speedtest client to PATH (Omarchy's Arch package installs /usr/lib/omarchy/speedtest)." >&2
  exit 1
else
  # The client replaces this script, so the panel stopping it stops the
  # transfers, and checks it still belongs to the panel that started it.
  export OMARCHY_SPEEDTEST_PARENT_PID=$PPID
  exec "$client" "$1"
fi
